# Copy to .env and fill in real values. Never commit .env.

# --- Supabase (direct read access) ---
# Service role key bypasses Row Level Security. This server only ever issues
# SELECT queries with it, but treat the key itself as a full-access secret.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Portal Warga production app (for n8n actions) ---
# The MCP server calls the app's own Vercel proxy (/api/n8n/:path), the same
# path the frontend uses, so it never needs n8n's basic-auth transport creds.
APP_BASE_URL=https://portal-warga.vercel.app

# HS256 secret of the n8n credential "PV App JWT". Required to mint the short
# lived App JWT this server sends as the actor identity for write actions
# (approve/reject user). Get this from whoever holds the n8n credential store;
# never hardcode it in code or commit it.
N8N_APP_JWT_SECRET=replace-with-pv-app-jwt-secret

# Supabase profiles.id this server acts as when calling protected n8n
# endpoints. Must belong to an active, approved profile with role >= pengurus
# (admin recommended) since n8n re-checks role server-side on every call.
MCP_ACTOR_PROFILE_ID=replace-with-admin-profile-uuid

# Optional, shown in tool responses for clarity only (not trusted by n8n).
MCP_ACTOR_EMAIL=admin@example.com
